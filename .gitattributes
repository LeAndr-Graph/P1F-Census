* text=auto

# --- Explicit text types (source, docs, project files) ---
*.c     text
*.cc    text
*.cpp   text
*.cxx   text
*.h     text
*.hpp   text
*.cu    text
*.cuh   text
*.py    text
*.md    text
*.txt   text
*.html  text
*.json  text
*.sln       text
*.vcxproj   text
*.filters   text
*.props     text
*.user      text

# --- Windows-only scripts must keep CRLF ---
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# The catalog is kept as the bytes the engine wrote, not reformatted on checkout.
AllResults/*.txt    -text

# --- Binary files: never convert ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.exe   binary
*.dll   binary
*.lib   binary
*.pdb   binary
*.tar   binary
*.zip   binary
